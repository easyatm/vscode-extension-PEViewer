{
    "name": "peviewer",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "0.0.260614",
    "publisher": "easyatm",
    "icon": "media/logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/easyatm/vscode-extension-PEViewer"
    },
    "engines": {
        "vscode": "^1.106.1"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "pe",
                "aliases": [
                    "PE",
                    "Portable Executable"
                ],
                "extensions": [
                    ".exe",
                    ".dll",
                    ".ocx",
                    ".sys",
                    ".scr",
                    ".drv",
                    ".cpl",
                    ".node"
                ]
            }
        ],
        "customEditors": [
            {
                "viewType": "peviewer.peViewer",
                "displayName": "PEViewer",
                "selector": [
                    {
                        "filenamePattern": "*.exe"
                    },
                    {
                        "filenamePattern": "*.dll"
                    },
                    {
                        "filenamePattern": "*.ocx"
                    },
                    {
                        "filenamePattern": "*.sys"
                    },
                    {
                        "filenamePattern": "*.scr"
                    },
                    {
                        "filenamePattern": "*.drv"
                    },
                    {
                        "filenamePattern": "*.cpl"
                    },
                    {
                        "filenamePattern": "*.node"
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "peviewer.openWithPEViewer",
                "title": "%command.openWithPEViewer.title%",
                "category": "%command.category%"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "peviewer.openWithPEViewer",
                    "when": "resourceExtname =~ /^\\.(exe|dll|ocx|sys|scr|drv|cpl|node)$/i"
                }
            ],
            "explorer/context": [
                {
                    "command": "peviewer.openWithPEViewer",
                    "when": "resourceExtname =~ /^\\.(exe|dll|ocx|sys|scr|drv|cpl|node)$/i",
                    "group": "7_modification"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "package-vsix": "vsce package",
        "publish-vscode": "vsce publish",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.106.1",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.7.1",
        "eslint": "^9.39.1",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3",
        "webpack": "^5.102.1",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "pe-parser": "^1.0.11"
    }
}
